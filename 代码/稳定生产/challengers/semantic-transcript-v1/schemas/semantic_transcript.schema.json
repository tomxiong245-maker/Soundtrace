{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-transcript-v1/semantic_transcript.schema.json",
  "title": "Semantic sentence and punctuation hypothesis layer",
  "type": "object",
  "required": [
    "schema_version",
    "layer_kind",
    "generated_at",
    "source_transcript",
    "policy",
    "sentences",
    "word_context_index",
    "integrity",
    "out_of_scope",
    "semantic_content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "semantic-transcript-v1"},
    "layer_kind": {"const": "sentence_boundary_and_punctuation_hypotheses"},
    "generated_at": {"type": "string"},
    "source_transcript": {
      "type": "object",
      "required": ["path", "sha256", "track_id", "sample_rate_hz", "frame_count", "word_count"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "track_id": {"type": "string"},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "frame_count": {"type": "integer", "minimum": 1},
        "word_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "policy": {"type": "object"},
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sentence_id", "track_id", "word_id_start", "word_id_end", "word_ids",
          "start_seconds", "end_seconds", "start_sample", "end_sample",
          "text_punctuated", "clauses", "boundary_after"
        ],
        "properties": {
          "sentence_id": {"type": "string"},
          "track_id": {"type": "string"},
          "word_id_start": {"type": "string"},
          "word_id_end": {"type": "string"},
          "word_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "start_sample": {"type": "integer", "minimum": 0},
          "end_sample": {"type": "integer", "minimum": 1},
          "text_punctuated": {"type": "string"},
          "clauses": {"type": "array", "minItems": 1},
          "boundary_after": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "word_context_index": {"type": "object"},
    "integrity": {"type": "object"},
    "out_of_scope": {
      "type": "object",
      "required": ["deletion_decision"],
      "properties": {"deletion_decision": {"const": "NOT_INCLUDED"}},
      "additionalProperties": true
    },
    "semantic_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
