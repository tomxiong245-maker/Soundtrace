{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asr-speaker-v1/normalized_transcript",
  "title": "Normalized transcript for one benchmark segment + one track",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "engine",
    "engine_version",
    "model_id",
    "segment_id",
    "source_track",
    "source_audio_sha256",
    "segment_start_offset_seconds_in_ep03",
    "sample_rate_hz",
    "words",
    "normalization"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "engine": {
      "type": "string",
      "enum": [
        "faster_whisper_small_vad_on",
        "funasr_paraformer",
        "mlx_whisper_turbo"
      ]
    },
    "engine_version": {"type": "string"},
    "model_id": {"type": "string"},
    "model_revision": {"type": ["string", "null"]},
    "segment_id": {"type": "string", "pattern": "^S\\d{2}$"},
    "source_track": {
      "type": "string",
      "pattern": "^(female|male|speech_mix|track_[0-9]{2,})$"
    },
    "source_audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "segment_start_offset_seconds_in_ep03": {"type": "number"},
    "sample_rate_hz": {"type": "integer"},
    "words": {
      "type": "array",
      "items": {"$ref": "word_record.schema.json"}
    },
    "raw_ref": {
      "type": "object",
      "properties": {
        "raw_path": {"type": "string"},
        "raw_sha256": {"type": "string"}
      }
    },
    "normalization": {
      "type": "object",
      "required": ["rules_version", "removed_llm_cleanup"],
      "properties": {
        "rules_version": {"type": "string"},
        "removed_llm_cleanup": {"type": "boolean", "const": true},
        "kept_fillers": {"type": "boolean", "const": true},
        "kept_negations": {"type": "boolean", "const": true},
        "kept_numbers": {"type": "boolean", "const": true},
        "kept_english_names": {"type": "boolean", "const": true}
      }
    }
  },
  "additionalProperties": false
}
